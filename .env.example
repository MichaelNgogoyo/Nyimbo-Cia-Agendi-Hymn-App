# Copy this to .env for local development. Replace both values before any deployment.
DATABASE_USERNAME=nyimbo
DATABASE_PASSWORD=replace-with-local-dev-password
NYIMBO_ADMIN_USERNAME=admin
NYIMBO_ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional for Android debug builds; use your HTTPS API URL in production.
NYIMBO_API_BASE_URL=http://10.0.2.2:8080/api/v1/
# Optional key for the native multi-event Google map. Keep out of source control.
MAPS_API_KEY=
FCM_ENABLED=false
FIREBASE_PROJECT_ID=

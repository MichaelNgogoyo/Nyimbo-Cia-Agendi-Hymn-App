<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginVertical="6dp" app:cardCornerRadius="16dp" app:strokeColor="#E8E3D8" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
        <ImageView android:id="@+id/event_image" android:layout_width="match_parent" android:layout_height="128dp" android:scaleType="centerCrop" android:contentDescription="Event image" android:background="#E8E3D8" android:visibility="gone" />
        <TextView android:id="@+id/event_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/navy" android:textStyle="bold" android:textSize="17sp" />
        <TextView android:id="@+id/event_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/muted" android:textSize="13sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/event_bookmark" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Save" android:textSize="12sp" style="@style/Widget.Material3.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/event_calendar" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Calendar" android:textSize="12sp" style="@style/Widget.Material3.Button.OutlinedButton" />
            <com.google.android.material.button.MaterialButton android:id="@+id/event_map" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="Directions" android:textSize="12sp" style="@style/Widget.Material3.Button" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

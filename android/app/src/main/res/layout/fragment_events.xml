<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/ivory">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="18dp" android:paddingTop="18dp" android:text="News &amp; Events" android:textColor="@color/navy" android:textStyle="bold" android:textSize="24sp" />
    <com.google.android.material.button.MaterialButton android:id="@+id/open_all_map" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_gravity="end" android:layout_marginEnd="16dp" android:text="View event map" android:textSize="12sp" style="@style/Widget.Material3.Button.OutlinedButton" />
    <TextView android:id="@+id/news_preview" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="6dp" android:padding="12dp" android:background="@color/surface" android:text="Loading church announcements…" android:textColor="@color/charcoal" android:textSize="13sp" android:maxLines="3" android:ellipsize="end" />
    <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="16dp" android:layout_marginTop="8dp" android:hint="Search title, venue, date or location" style="@style/Widget.Material3.TextInputLayout.OutlinedBox">
        <com.google.android.material.textfield.TextInputEditText android:id="@+id/event_search" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true" />
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton android:id="@+id/event_date_filter" android:layout_width="wrap_content" android:layout_height="38dp" android:layout_marginStart="16dp" android:layout_marginTop="4dp" android:text="Any date · Set range" android:textSize="12sp" style="@style/Widget.Material3.Button.TextButton" />
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none">
        <com.google.android.material.chip.ChipGroup android:id="@+id/event_categories" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:paddingVertical="6dp" app:singleSelection="true" app:selectionRequired="true">
            <com.google.android.material.chip.Chip android:id="@+id/category_all" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" android:text="All" style="@style/Widget.Material3.Chip.Filter" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Camp Meetings" style="@style/Widget.Material3.Chip.Filter" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sabbath Worship" style="@style/Widget.Material3.Chip.Filter" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Crusades" style="@style/Widget.Material3.Chip.Filter" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Youth Events" style="@style/Widget.Material3.Chip.Filter" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Choir Events" style="@style/Widget.Material3.Chip.Filter" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Conferences" style="@style/Widget.Material3.Chip.Filter" />
            <com.google.android.material.chip.Chip android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Special Programs" style="@style/Widget.Material3.Chip.Filter" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>
    <TextView android:id="@+id/events_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingHorizontal="18dp" android:text="Sample events are marked DEMO and are not published events." android:textColor="@color/muted" android:textSize="12sp" />
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/event_list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="12dp" />
</LinearLayout>

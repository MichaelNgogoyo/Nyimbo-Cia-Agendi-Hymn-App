<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ivory"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/appearance"
            android:textColor="@color/navy"
            android:textSize="23sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/appearance_description"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/appearance_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_settings_group"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <RadioButton
                android:id="@+id/theme_system"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/forest"
                android:fontFamily="@font/inter"
                android:text="@string/theme_system"
                android:textColor="@color/charcoal"
                android:textSize="16sp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

            <RadioButton
                android:id="@+id/theme_light"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/forest"
                android:fontFamily="@font/inter"
                android:text="@string/theme_light"
                android:textColor="@color/charcoal"
                android:textSize="16sp" />

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/divider" />

            <RadioButton
                android:id="@+id/theme_dark"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:buttonTint="@color/forest"
                android:fontFamily="@font/inter"
                android:text="@string/theme_dark"
                android:textColor="@color/charcoal"
                android:textSize="16sp" />
        </RadioGroup>

        <View
            android:id="@+id/reminders_divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/divider" />

        <TextView
            android:id="@+id/reminders_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/reminders_title"
            android:textColor="@color/navy"
            android:textSize="18sp"
            android:textStyle="bold" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/notifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/reminders_description"
            android:textColor="@color/charcoal"
            app:useMaterialThemeColors="true" />
    </LinearLayout>
</ScrollView>

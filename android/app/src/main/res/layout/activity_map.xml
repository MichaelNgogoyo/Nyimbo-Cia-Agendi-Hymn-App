<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/map_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/brand_navy">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="12dp"
        android:background="@color/brand_navy">
        <ImageButton
            android:id="@+id/map_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_toolbar_action"
            android:src="@drawable/ic_round_back"
            android:contentDescription="@string/reader_back" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name"
            android:textColor="@color/toolbar_title"
            android:textSize="17sp" />
        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_logo_circle"
            android:clipToOutline="true"
            android:contentDescription="@string/app_logo_description"
            android:padding="2dp"
            android:scaleType="centerCrop"
            android:src="@drawable/nyimbo_agendi_brand" />
    </LinearLayout>
    <TextView
        android:id="@+id/map_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:gravity="center"
        android:background="@color/ivory"
        android:textColor="@color/muted"
        android:textSize="13sp" />
    <FrameLayout
        android:id="@+id/map_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
